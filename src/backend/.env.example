APP_NAME=RakanSpace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Where the Next.js frontend is served. Used for links in emails and CORS.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (docker-compose exposes it on 5433 by default)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=rakanspace
DB_USERNAME=rakanspace
DB_PASSWORD=secret

# Sessions (cookie-based SPA authentication through Sanctum)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty for localhost. In production use the shared parent domain, e.g. .example.com
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Hosts (with port) of the SPA allowed to use cookie authentication.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Disk used for private attachments: "local" (storage/app/private) or "s3".
ATTACHMENTS_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Redis (docker-compose exposes it on 6380 by default)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

# Mail goes to Mailpit locally: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@rakanspace.test"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible storage for production attachments (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Laravel Reverb (WebSocket server)
REVERB_APP_ID=rakanspace
REVERB_APP_KEY=rakanspace-key
REVERB_APP_SECRET=change-me-reverb-secret
# Host/port Laravel uses to publish events to Reverb
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Address the Reverb server binds to
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
