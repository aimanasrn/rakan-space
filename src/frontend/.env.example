# URL of the Laravel API as seen by the browser. Use "localhost" (not 127.0.0.1)
# so the session and XSRF cookies are shared between the two ports.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Laravel Reverb (WebSocket) connection used by Laravel Echo
NEXT_PUBLIC_REVERB_APP_KEY=rakanspace-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
